// The crashyard worker: the dashboard (TanStack Start), the ingest and Sentry APIs, and the cron (see AGENTS.md).
// Deploying your own: the Deploy to Cloudflare button, or `pnpm run deploy` (docs/deploying.md). Your domain and
// values go in a git-ignored wrangler.local.json, which the build lays over this file (vite.config.ts). The first owner
// is made at /setup with the code in the secret SETUP_CODE (pnpm run setup sets it, or add it under the worker's
// Variables and Secrets).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crashyard",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  // On <name>.<account>.workers.dev until wrangler.local.json gives it a domain of your own
  "workers_dev": true,
  "preview_urls": false,
  // Every minute: uptime checks and missed check-ins; the daily jobs run in the 03:00 UTC minute
  "triggers": { "crons": ["* * * * *"] },
  // No ids: `wrangler deploy` makes the database and the bucket in your account the first time
  "d1_databases": [{ "binding": "DB", "database_name": "crashyard", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "crashyard-files" }],
  // Email notifications through Cloudflare Email Routing (to verified addresses); EMAIL_FROM below turns them on
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // The address email notifications come from, on a domain with Email Routing on; empty: no email
    "EMAIL_FROM": "",
    // Where the dashboard is, for links in notifications that the cron sends (monitors)
    "PUBLIC_URL": "",
  },
}
