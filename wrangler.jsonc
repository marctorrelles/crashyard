// The crashyard worker: the dashboard (TanStack Start), the ingest and Sentry APIs, and the cron (see AGENTS.md).
// Deploying your own: change `routes` to your domain and the Access values in `vars` (docs/deploying.md).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "crashyard",
  "main": "src/server.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "routes": [{ "pattern": "crashyard.marctorrelles.com", "custom_domain": true }],
  "workers_dev": false,
  "preview_urls": false,
  // Every minute: uptime checks and missed check-ins; the daily jobs run in the 03:00 UTC minute
  "triggers": { "crons": ["* * * * *"] },
  // No ids: `wrangler deploy` makes the database and the bucket in your account the first time
  "d1_databases": [{ "binding": "DB", "database_name": "crashyard", "migrations_dir": "migrations" }],
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "crashyard-files" }],
  // Email notifications through Cloudflare Email Routing (to verified addresses); EMAIL_FROM below turns them on
  "send_email": [{ "name": "EMAIL" }],
  "vars": {
    // Cloudflare Access in front of the dashboard: your team's domain and the application's audience tag.
    // Empty means every dashboard request is refused (fail closed), except on a local dev server.
    "ACCESS_TEAM_DOMAIN": "marctorrelles.cloudflareaccess.com",
    // The address email notifications come from, on a domain with Email Routing on; empty: no email
    "EMAIL_FROM": "",
    "ACCESS_AUD": "23cf871024e213b2d0c15c0796e1dc3a7f324c404b6d71af99bd9c650d5892ca",
  },
}
