{
  "name": "crashyard",
  "version": "0.4.0",
  "private": true,
  "description": "A Sentry-compatible crash, error and log reporter you run on your own Cloudflare account",
  "license": "MIT",
  "author": "Marc Torrelles",
  "homepage": "https://github.com/marctorrelles/crashyard#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marctorrelles/crashyard.git"
  },
  "bugs": "https://github.com/marctorrelles/crashyard/issues",
  "keywords": [
    "sentry",
    "crash-reporting",
    "error-tracking",
    "self-hosted",
    "cloudflare-workers",
    "observability"
  ],
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "vite build && vite preview",
    "deploy": "vite build && node scripts/deploy-guard.mjs && wrangler d1 migrations apply DB --remote -c dist/server/wrangler.json && wrangler deploy",
    "site:dev": "vite -c site/vite.config.ts",
    "site:deploy": "vite build -c site/vite.config.ts && wrangler deploy -c site/wrangler.jsonc",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm knip && pnpm test && pnpm build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsr generate && tsc --noEmit",
    "knip": "knip",
    "test": "vitest run",
    "cf-typegen": "wrangler types",
    "prepare": "lefthook install",
    "seed": "node scripts/seed.mjs",
    "setup": "node scripts/setup.mjs",
    "recovery-code": "node scripts/recovery-code.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "@tabler/icons-react": "^3.52.0",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-router": "1.170.46",
    "@tanstack/react-start": "1.169.7",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "fflate": "^0.8.3",
    "radix-ui": "^1.8.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "recharts": "3.11.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.70.1",
    "@eslint/js": "^10.0.1",
    "@sentry/cli": "^3.8.2",
    "@sentry/node": "^11.15.0",
    "@tanstack/router-cli": "^1.168.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "knip": "^6.46.1",
    "lefthook": "^2.2.2",
    "prettier": "^3.10.1",
    "shadcn": "^4.23.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "lightningcss",
      "sharp",
      "workerd"
    ]
  }
}
